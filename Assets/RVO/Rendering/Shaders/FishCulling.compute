#pragma kernel Cull
#pragma kernel CopyDisplayHistory
#include "FishData.hlsl"
StructuredBuffer<FishData> _Previous, _Current;
RWStructuredBuffer<FishData> _Prepared;
RWStructuredBuffer<FishData> _PreviousDisplay;
RWStructuredBuffer<uint4> _LodHistory;
AppendStructuredBuffer<uint> _Visible0, _Visible1, _Visible2, _Visible3;
float4 _Planes[6];
float4 _CameraPosition, _CameraForward, _LodPixels;
float _Alpha, _ProjectionScale, _NearClip, _Hysteresis;
int _Count, _Orthographic, _CullEnabled, _ForceLod, _CrossCards;

// 保留前一显示帧的实际插值姿态；仿真 Previous 不能替代 motion history。
[numthreads(128, 1, 1)]
void CopyDisplayHistory(uint3 thread : SV_DispatchThreadID)
{
    if (thread.x < (uint)_Count) _PreviousDisplay[thread.x] = _Prepared[thread.x];
}

[numthreads(128, 1, 1)]
void Cull(uint3 thread : SV_DispatchThreadID)
{
    uint index = thread.x;
    if (index >= (uint)_Count) return;
    FishData a = _Previous[index], b = _Current[index], fish = b;
    // CPU 每个 Tick 会折返旧端点相位；GPU 端点复用也必须执行同样折返，避免越过 2π 时反向插值。
    a.animation.x = fmod(a.animation.x, 6.28318530718);
    fish.positionRadius = lerp(a.positionRadius, b.positionRadius, _Alpha);
    fish.rotation = normalize(lerp(a.rotation, b.rotation, _Alpha));
    fish.animation = lerp(a.animation, b.animation, _Alpha);
    _Prepared[index] = fish;
    if ((fish.identity.z & 2u) != 0) return;
    float3 p = fish.positionRadius.xyz;
    float radius = fish.positionRadius.w;
    float z = dot(p - _CameraPosition.xyz, _CameraForward.xyz);
    // 用球体前端深度保守估算尺寸；近裁剪面相交时不会误选过低 LOD。
    float pixels = _ProjectionScale * radius / (_Orthographic != 0 ? 1 : max(z - radius, _NearClip));
    uint4 history = _LodHistory[index];
    uint lod = pixels >= _LodPixels.x ? 0 : pixels >= _LodPixels.y ? 1 : pixels >= _LodPixels.z ? 2 : 3;
    if (history.x == fish.identity.x && history.y == fish.identity.y && (history.w & 1u) != 0)
    {
        lod = min(history.z, 3u);
        while (lod > 0 && pixels >= _LodPixels[lod - 1] * (1 + _Hysteresis)) lod--;
        while (lod < 3 && pixels < _LodPixels[lod] * (1 - _Hysteresis)) lod++;
    }
    if (_ForceLod >= 0) lod = (uint)_ForceLod;
    // 交叉面沿鱼轴端视会消失；历史高位独立保存回退滞回，不污染尺寸 LOD。
    float3 view = _Orthographic != 0 ? -_CameraForward.xyz : normalize(_CameraPosition.xyz - p + 1e-8);
    float axial = abs(dot(view, FishRotate(fish.rotation, float3(0,0,1))));
    bool sameIdentity = history.x == fish.identity.x && history.y == fish.identity.y;
    bool fallback = _CrossCards != 0 && axial > (sameIdentity && (history.w & 2u) != 0 ? 0.80 : 0.88);
    _LodHistory[index] = uint4(fish.identity.xy, lod, fallback ? 3 : 1);
    if (fallback && lod == 2) lod = 1;
    if (_CullEnabled != 0)
        for (int plane = 0; plane < 6; plane++)
            if (dot(_Planes[plane].xyz, p) + _Planes[plane].w < -radius) return;
    if (lod == 0) _Visible0.Append(index);
    else if (lod == 1) _Visible1.Append(index);
    else if (lod == 2) _Visible2.Append(index);
    else _Visible3.Append(index);
}
